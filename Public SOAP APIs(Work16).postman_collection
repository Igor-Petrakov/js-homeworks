    {
      "name": "Book ISBN Numbers",
      "item": [
        {
          "name": "Is Valid ISBN13 Number",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 1. Перевірка статусу\r",
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// 2. Перевірка швидкості відповіді\r",
                  "pm.test(\"Response time is less than 5000ms\", function () {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(5000);\r",
                  "});\r",
                  "\r",
                  "// 3. Перевірка наявності заголовку Content-Type\r",
                  "pm.test(\"Content-Type header is present\", function () {\r",
                  "    pm.response.to.have.header(\"Content-Type\");\r",
                  "});\r",
                  "\r",
                  "// 4. Перевірка формату даних у заголовку\r",
                  "pm.test(\"Content-Type is text/xml\", function () {\r",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/xml\");\r",
                  "});\r",
                  "\r",
                  "// 5. Перевірка, що тіло відповіді містить головний тег Envelope\r",
                  "pm.test(\"Body contains soap:Envelope as text\", function () {\r",
                  "    pm.expect(pm.response.text()).to.include(\"soap:Envelope\");\r",
                  "});\r",
                  "\r",
                  "let jsonResponse = xml2Json(pm.response.text());\r",
                  "\r",
                  "// 6. Перевірка наявності конверта як об'єкта\r",
                  "pm.test(\"JSON object contains soap:Envelope\", function () {\r",
                  "    pm.expect(jsonResponse).to.have.property('soap:Envelope');\r",
                  "});\r",
                  "\r",
                  "// 7. Перевірка наявності тіла SOAP\r",
                  "pm.test(\"JSON object contains soap:Body\", function () {\r",
                  "    pm.expect(jsonResponse['soap:Envelope']).to.have.property('soap:Body');\r",
                  "});\r",
                  "\r",
                  "// 8. Перевірка відсутності помилок сервера (SOAP Fault)\r",
                  "pm.test(\"No SOAP Fault in response\", function () {\r",
                  "    pm.expect(jsonResponse['soap:Envelope']['soap:Body']).to.not.have.property('soap:Fault');\r",
                  "});\r",
                  "\r",
                  "// 9. Перевірка наявності блоку відповіді IsValidISBN13Response\r",
                  "pm.test(\"Response contains m:IsValidISBN13Response\", function () {\r",
                  "    pm.expect(jsonResponse['soap:Envelope']['soap:Body']).to.have.property('m:IsValidISBN13Response');\r",
                  "});\r",
                  "\r",
                  "// 10. Перевірка, що ISBN дійсно валідний\r",
                  "pm.test(\"ISBN13 validation result is true\", function () {\r",
                  "    let result = jsonResponse['soap:Envelope']['soap:Body']['m:IsValidISBN13Response']['m:IsValidISBN13Result'];\r",
                  "    pm.expect(result).to.eql(\"true\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml; charset=utf-8",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <IsValidISBN13 xmlns=\"http://webservices.daehosting.com/ISBN\">\n      <sISBN>9780596009205</sISBN>\n    </IsValidISBN13>\n  </soap:Body>\n</soap:Envelope>"
            },
            "url": {
              "raw": "http://webservices.daehosting.com/services/isbnservice.wso",
              "protocol": "http",
              "host": [
                "webservices",
                "daehosting",
                "com"
